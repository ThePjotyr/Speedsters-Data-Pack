# As a speedster: removes the level modifiers (ids are stable, so they never stack).
attribute @s minecraft:movement_speed modifier remove tp_speedsters:speed
attribute @s minecraft:jump_strength modifier remove tp_speedsters:jump
attribute @s minecraft:attack_damage modifier remove tp_speedsters:damage
attribute @s minecraft:step_height modifier remove tp_speedsters:step
attribute @s minecraft:safe_fall_distance modifier remove tp_speedsters:fall
